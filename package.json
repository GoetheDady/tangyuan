{
  "name": "yuanxiao",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @yuanxiao/desktop dev",
    "build": "bun run --filter @yuanxiao/desktop build",
    "lint": "bun run --workspaces --if-present lint",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "verify:local": "bun run lint && bun run typecheck && bun run test",
    "package:mac": "bun run --filter @yuanxiao/desktop package:mac",
    "smoke:packaged:mac": "bun run --filter @yuanxiao/desktop smoke:packaged:mac",
    "format": "bun run --workspaces --if-present format"
  },
  "overrides": {
    "@electron/get": "3.1.0"
  },
  "trustedDependencies": [
    "@google/genai",
    "electron",
    "electron-winstaller",
    "esbuild",
    "protobufjs"
  ],
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
